# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database (Direct connection string — from Supabase → Settings → Database → URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# AI APIs (only 2 keys needed for the full pipeline)
# Gemini: prompt refinement + Imagen 3 images + Veo 2 video
GEMINI_API_KEY=your_gemini_api_key
# Freepik: Magnific/Mystic images + AI Video
FREEPIK_API_KEY=your_freepik_api_key
